<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <AssemblyName>SmoothWizardOptimizer</AssemblyName>
    <Description>SmoothWizard CS2 server FPS optimizer (CounterStrikeSharp)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same pin as IGLNest.Server. The game server supplies the API assembly. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.342">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
